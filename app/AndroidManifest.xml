<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.mireneye.a2itg2">
	<!-- For downloading packs (later steps). -->
	<uses-permission android:name="android.permission.INTERNET"/>
	<application android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:hasCode="true">
		<!-- OdinActivity (added by `odin bundle android`) is a NativeActivity that also passes on
		     activity results, which the folder picker answers through. -->
		<activity
			android:name="org.odin_lang.OdinActivity"
			android:exported="true"
			android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode">
			<!-- The library to load: lib/<abi>/liba2itg2.so. -->
			<meta-data android:name="android.app.lib_name" android:value="a2itg2"/>
			<intent-filter>
				<action android:name="android.intent.action.MAIN"/>
				<category android:name="android.intent.category.LAUNCHER"/>
			</intent-filter>
		</activity>
	</application>
</manifest>
